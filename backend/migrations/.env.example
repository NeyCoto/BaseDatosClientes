# ──────────────────────────────────────────────
#  Server
# ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ──────────────────────────────────────────────
#  Database
# ──────────────────────────────────────────────
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────
#  CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────
#  Rate limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ──────────────────────────────────────────────
#  JWT  — generate both secrets with:
#  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
#  Rules:
#  • Use DIFFERENT values for access and refresh secrets
#  • Minimum 32 characters (64+ recommended)
#  • Never commit real values to source control
#  • Rotate secrets to invalidate ALL tokens instantly
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_for_access_token
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string_for_refresh
